# AutoPublish 环境变量配置
# 复制此文件为 .env 并填入实际值

# 应用配置
APP_NAME=墨掌柜
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars-long

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+psycopg2://autopublish:your_password@localhost:5432/autopublish

# 阿里通义千问 API（推荐，国内可用）
# QWEN_API_KEY=sk-your-actual-key-here
# DASHSCOPE_API_KEY=sk-your-actual-key-here  （兼容旧名称）
QWEN_MODEL=qwen-plus

# 智谱 AI API（备用）
# ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenAI API（备用，需代理）
# OPENAI_API_KEY=sk-your-actual-key-here
OPENAI_MODEL=gpt-3.5-turbo-16k

# ─────────────────────────────────────────────────────────────
# MCP (Model Context Protocol) 多 Server 配置
# ─────────────────────────────────────────────────────────────
# 所有 Server 均支持 stdio（子进程）和 streamable-http（独立 HTTP 服务）两种 transport
# stdio：默认，无需额外配置，适合本地开发
# HTTP：生产环境推荐，启动时加参数：python server.py http

# ── 1. Open WebSearch（默认启用，免费的 DuckDuckGo）────
# 提供 web_search / news_search / fetch_page 三个工具
# 降级链：DuckDuckGo（免费）→ Bing（需 BING_API_KEY）→ SerpAPI（需 SERPAPI_API_KEY）
# MCP_ENABLE_SEARCH=false  # 设为 false 可禁用
# BING_API_KEY=your-bing-key
# SERPAPI_API_KEY=your-serpapi-key

# ── 2. Brave Search（隐私优先搜索，AI 友好）────
# 需注册：https://brave.com/search/api/  免费层级：每月 2,000 次
# MCP_ENABLE_BRAVE=false
# BRAVE_API_KEY=your-brave-api-key

# ── 3. Jina Reader（网页 Markdown 抓取，完全免费）────
# 提供 read_url / read_urls_batch 两个工具
# 完全免费，无需 API Key，自动降级到直接 HTTP 抓取
# MCP_ENABLE_JINA=true  # 默认启用，无需配置

# ── 4. Tavily Search（AI 优化新闻/博客搜索）────
# 需注册：https://app.tavily.com  免费层级：每月 1,000 次
# MCP_ENABLE_TAVILY=false
# TAVILY_API_KEY=your-tavily-api-key

# ── 5. Pexels（免费高清图片搜索）────
# 需注册：https://www.pexels.com/api/  免费层级：每月 200 次
# MCP_ENABLE_PEXELS=false
# PEXELS_API_KEY=your-pexels-api-key

# ── 6. GitHub（代码/Issues/PR 搜索）────
# 可选，无需 Token 也能访问公开仓库（更严格限速）
# 推荐创建 Token：https://github.com/settings/tokens  (public_repo scope)
# MCP_ENABLE_GITHUB=false
# GITHUB_TOKEN=ghp_your-token-here

# ─────────────────────────────────────────────────────────────
# 可观测性配置 (Observability)
# ─────────────────────────────────────────────────────────────

# 是否输出 JSON 格式日志（生产建议 true）
LOG_JSON=true

# 服务标识
OTEL_SERVICE_NAME=autopublish-api
DEPLOYMENT_ENVIRONMENT=development

# Elasticsearch（trace/logs 持久化存储）
ELASTICSEARCH_URL=http://localhost:9200

