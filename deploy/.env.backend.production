# ============================================================
# AutoPublish Backend - Production Environment Variables
# 部署到七牛云 LAS
# ============================================================

# 应用配置
APP_NAME=AutoPublish
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars-long
LOG_JSON=true

# 数据库（PostgreSQL）
# 实际运行时 DATABASE_URL 由 docker-compose.yml 的环境变量注入
DATABASE_URL=postgresql+psycopg2://autopublish:autopublish_prod_2024@postgres:5432/autopublish

# Redis
REDIS_URL=redis://redis:6379/0

# ── LLM 配置 ────────────────────────────────────────────────

# 阿里通义千问
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# 智谱 AI
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI（备用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo-16k

# 默认 LLM Provider
DEFAULT_LLM_PROVIDER=zhipu

# 博查搜索 API
BOCHA_API_KEY=

# ── 可观测性 ──────────────────────────────────────────────
OTEL_SERVICE_NAME=autopublish-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.5
ELASTICSEARCH_URL=http://elasticsearch:9200
DEPLOYMENT_ENVIRONMENT=production
